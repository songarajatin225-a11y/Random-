# Copy to .env, or set these in your host's dashboard.

# Required. The password for /admin. Minimum 10 characters — the server
# refuses to start without it, so an editor is never left open to the world.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Recommended. Keeps you signed in across restarts and deploys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed — it adds the Secure flag to the session cookie.
NODE_ENV=production

# Where saved text and uploaded photos live. Point this at a persistent
# disk on your host, or content is lost on every redeploy. See README.
DATA_DIR=./data

PORT=3000
